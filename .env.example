# Provider for Stage 2 semantic verification.
# "fake" needs no network and is the default so the pipeline runs offline.
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# Retrieval. "local" is a deterministic offline embedder (no torch download).
# "sentence-transformers" uses EMBED_MODEL and needs `pip install -e ".[embed]"`.
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=3
